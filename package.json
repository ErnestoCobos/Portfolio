{
  "name": "cobosio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/git-modified-dates.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "translate": "node scripts/translate-posts.mjs",
    "translate:force": "rm -f content/blog/.translator-cache.json && node scripts/translate-posts.mjs",
    "sync-notion": "node scripts/fetch-notion.mjs && node scripts/translate-posts.mjs",
    "sync-notion:dry-run": "node scripts/fetch-notion.mjs"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "marked": "^18.0.4",
    "next": "16.2.6",
    "notion-to-md": "^3.1.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10"
    }
  }
}
