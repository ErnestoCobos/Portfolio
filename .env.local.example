# Translator pipeline (scripts/translate-posts.mjs).
# Required only when there are blog posts that need (re)translation —
# cached runs do not call the API and don't need a key.

# DeepSeek API key. Get one at https://platform.deepseek.com/api_keys
# Used by default and when frontmatter sets `translator: deepseek-v4-pro`
# or `translator: deepseek-v4-flash`.
DEEPSEEK_API_KEY=

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Only required when a post's frontmatter sets `translator: claude-sonnet-4-6`
# (premium quality opt-in for posts where DeepSeek output isn't natural enough).
ANTHROPIC_API_KEY=
