# Translator pipeline (scripts/translate-posts.mjs).
#
# Required only when there are blog posts that need (re)translation.
# Cached runs do not call the API and need no key. The build is
# resilient: missing key + existing es.md → warning, no failure.

# Vercel AI Gateway API key. Get one at:
#   https://vercel.com/dashboard → your project → AI Gateway → API Keys
#
# Routes to DeepSeek + Anthropic + 270+ models behind a single key.
# Zero markup vs direct provider pricing. Free $5/month credits cover
# this project's annual translation cost ~25x over.
#
# When deployed on Vercel, this is set automatically via OIDC and no
# explicit key is needed.
AI_GATEWAY_API_KEY=

# Optional: POST endpoint for the blog newsletter form (e.g. Buttondown,
# ConvertKit, your own route). When unset, the blog shows an RSS follow
# row instead of the form.
NEXT_PUBLIC_NEWSLETTER_URL=

# B3 contact form (app/api/contact/route.ts) — Resend REST API, no SDK.
# Without RESEND_API_KEY the route answers 501 {fallback:"mailto"} and the
# form silently falls back to its mailto hand-off. Get a key at:
#   https://resend.com → API Keys
RESEND_API_KEY=

# Where contact-form email is delivered. Falls back to hola@cobos.io.
CONTACT_TO=

# sertoma-server health (app/start/sertomaData.ts) — the in-cluster
# sentinel agent exposed via Cloudflare Tunnel. The STATUS_TOKEN is part
# of the path (timing-safe checked server-side); regenerate on the server:
#   kubectl -n monitoring create secret generic sentinel-secrets \
#     --from-literal=STATUS_TOKEN="$(openssl rand -hex 24)" --dry-run=client -o yaml | kubectl apply -f -
# Without this var the systems panel shows "sin señal del cluster" and
# keeps working with the plain HEAD-ping row.
SERTOMA_STATUS_URL=
