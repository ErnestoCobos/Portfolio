# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor & tooling
.claude/
.idea/
.vscode/

# Generated by scripts/git-modified-dates.mjs (prebuild). Re-runs on
# every build, so committing it would just create churn.
content/blog/.modified-dates.json

# scripts/translate-posts.mjs cache — sha256(en.md + model) →
# translation metadata. INTENTIONALLY committed: without it, every
# Vercel build retranslates all posts from scratch (~9 min cold-start
# on DeepSeek V4 Pro). With it committed, unchanged posts are zero-cost
# (~30s build). Diff churn is low — file only changes when actual
# content changes, in which case the new translation is the correct
# artifact to ship anyway.
# (Intentionally NOT ignored — leave this comment for future devs who
#  may otherwise add it back.)

# Optional manual escape hatch for the translation pipeline. If an
# es.override.md exists, it is copied verbatim as es.md instead of
# calling the LLM. Commit deliberately when used (it's the source of
# truth for that locale, takes precedence over the auto-generated one).
# (intentionally NOT ignored — comment for clarity, no glob.)
.env*.local
.antigravitycli/
.codex/
.copilot/
.claude/local/
