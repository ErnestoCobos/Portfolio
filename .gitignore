# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor & tooling
.claude/
.idea/
.vscode/

# Generated by scripts/git-modified-dates.mjs (prebuild). Re-runs on
# every build, so committing it would just create churn.
content/blog/.modified-dates.json

# Generated by scripts/translate-posts.mjs (prebuild). Per-dev local
# cache mapping sha256(en.md + model) → last-translation metadata.
# Each environment (laptop, CI) maintains its own cache.
content/blog/.translator-cache.json

# Optional manual escape hatch for the translation pipeline. If an
# es.override.md exists, it is copied verbatim as es.md instead of
# calling the LLM. Commit deliberately when used (it's the source of
# truth for that locale, takes precedence over the auto-generated one).
# (intentionally NOT ignored — comment for clarity, no glob.)
.env*.local
